# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5000

# ============================================
# Database - MongoDB
# ============================================
MONGO_URI=mongodb://127.0.0.1:27017/edusearch
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5
AUTO_CREATE_INDEXES=true

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=change_this_to_a_random_secret
JWT_REFRESH_SECRET=change_this_to_a_random_refresh_secret
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=edusearch-backend
JWT_AUDIENCE=edusearch-client
JWT_ROTATE_REFRESH_TOKENS=false
JWT_ENABLE_BLACKLIST=true

# ============================================
# Email / SMTP
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com
SUPERADMIN_EMAIL=admin@yourdomain.com

# ============================================
# Redis (optional - set DISABLED=true if not used)
# ============================================
REDIS_DISABLED=true
REDIS_URL=redis://localhost:6379

# ============================================
# Payment Gateway - Razorpay
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================
# File Uploads
# ============================================
MAX_FILE_SIZE=10485760

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Auth
# ============================================
AUTH_ENABLED=true
